          </Badge>
        ))}
        <Badge variant="outline" className="font-normal">
          Difficulty {phrase.difficulty}/5
        </Badge>
        {showTimeToReveal && timeToReveal && (
          <Badge variant="outline" className="font-normal ml-auto">
