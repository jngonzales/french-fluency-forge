      // N for next/continue
      if (e.key === 'n' && nextQuestion) {
        if (nextQuestion.question.type === 'free_text' && freeTextAnswer.trim()) {
          handleFreeTextSubmit();
        } else if (
          !nextQuestion.question.options &&
          nextQuestion.question.type !== 'free_text' &&
