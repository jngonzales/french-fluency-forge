      if (e.key >= '1' && e.key <= '6' && nextQuestion?.question.options) {
        const index = parseInt(e.key) - 1;
        if (index < nextQuestion.question.options.length) {
          handleAnswer(nextQuestion.question.options[index].value);
        }
