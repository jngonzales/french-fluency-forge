export type RepairEventType = 'E1' | 'E2' | 'E3' | 'E4' | 'E5';

export interface RepairEvent {
  event_id: RepairEventType;
  event_type: string;
  introduced_turn: number;
  resolved_turn: number | null;
  resolution_evidence_snippet?: string;
